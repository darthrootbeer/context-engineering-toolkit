{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/job-assessment/findings.schema.json",
  "title": "findings.json",
  "description": "What the model hands back for one assessment. Every rating is tied to a quoted phrase from the posting. There is no free-text field for a strength: a qualification is either a match that cites evidence ids, or an unproven skill. Code checks the quotes and ids (check_findings.py), does the arithmetic (score_helpers.py) and applies the verdict rules (verdict.py).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "posting_file", "lane", "hard_block", "job_type_override", "requirements", "autonomy",
    "pay", "culture", "qualifications", "avoid_core_skills", "company_read",
    "verdict_reason", "keyword_signals_found", "new_signals_to_consider"
  ],
  "properties": {
    "_banner": {"type": "string", "description": "Fixture files only: the FICTIONAL banner, as the first key."},
    "posting_file": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "minLength": 1},

    "hard_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tripped", "id", "quote", "named_exception"],
      "properties": {
        "tripped": {"type": "boolean"},
        "id": {"type": ["string", "null"]},
        "quote": {"type": ["string", "null"]},
        "named_exception": {"type": ["string", "null"]}
      }
    },

    "job_type_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fired", "skill", "quotes", "evidence_checked"],
      "properties": {
        "fired": {"type": "boolean"},
        "skill": {"type": ["string", "null"]},
        "quotes": {"$ref": "#/$defs/strings"},
        "evidence_checked": {"$ref": "#/$defs/strings"}
      }
    },

    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rating", "quote", "read"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rating": {"$ref": "#/$defs/rating"},
          "quote": {"type": ["string", "null"], "description": "Required for every rating except unknown."},
          "read": {"type": "string"}
        }
      }
    },

    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "quotes", "read"],
      "properties": {
        "net": {"enum": ["positive", "neutral", "negative", "unknown"]},
        "quotes": {"$ref": "#/$defs/strings"},
        "read": {"type": "string"}
      }
    },

    "pay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stated", "tiers", "tier_used", "top", "other_pay_noted"],
      "properties": {
        "stated": {"type": "boolean"},
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": {"type": "string"},
              "low": {"type": ["number", "null"]},
              "high": {"type": ["number", "null"]},
              "quote": {"type": ["string", "null"]}
            }
          }
        },
        "tier_used": {"type": ["string", "null"]},
        "top": {"type": ["number", "null"], "description": "Top of the base pay range in the tier used. null when pay is unstated."},
        "other_pay_noted": {"$ref": "#/$defs/strings"}
      }
    },

    "culture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perks", "strong_positive_phrases", "low_time_off", "hustle", "soft_flags_tripped", "negative_phrases"],
      "properties": {
        "perks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["perk_id", "quote"],
            "properties": {"perk_id": {"type": "string"}, "quote": {"type": "string"}}
          }
        },
        "strong_positive_phrases": {"$ref": "#/$defs/phrase_quotes"},
        "low_time_off": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["quote"],
              "properties": {
                "days": {"type": ["number", "null"]},
                "accrual_only": {"type": "boolean"},
                "quote": {"type": "string"}
              }
            }
          ]
        },
        "hustle": {"$ref": "#/$defs/phrase_quotes"},
        "soft_flags_tripped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "quote"],
            "properties": {"id": {"type": "string"}, "quote": {"type": "string"}}
          }
        },
        "negative_phrases": {"$ref": "#/$defs/phrase_quotes"}
      }
    },

    "qualifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "years_required", "narrow_subdomain", "known_gaps_hit", "self_score_gaps",
        "working_style_mismatch", "matches", "unproven"
      ],
      "properties": {
        "years_required": {"type": ["number", "null"]},
        "narrow_subdomain": {"type": "boolean"},
        "known_gaps_hit": {"$ref": "#/$defs/strings"},
        "self_score_gaps": {"$ref": "#/$defs/strings"},
        "working_style_mismatch": {"type": "boolean"},
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_quote", "evidence_ids"],
            "properties": {
              "requirement_quote": {"type": "string", "minLength": 1},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        },
        "unproven": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill_id", "requirement_quote"],
            "properties": {
              "skill_id": {"type": "string"},
              "requirement_quote": {"type": "string"},
              "status": {"const": "unproven"}
            }
          }
        }
      }
    },

    "avoid_core_skills": {"$ref": "#/$defs/strings"},

    "company_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "name", "stored_reason"],
      "properties": {
        "status": {"enum": ["none", "high_interest", "good_not_dream"], "description": "Never an input to any score or the verdict."},
        "name": {"type": ["string", "null"]},
        "stored_reason": {"type": ["string", "null"]}
      }
    },

    "verdict_reason": {"type": "string", "minLength": 1},

    "keyword_signals_found": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phrase", "read"],
        "properties": {"phrase": {"type": "string"}, "read": {"type": "string"}}
      }
    },

    "new_signals_to_consider": {"type": "array"}
  },

  "$defs": {
    "rating": {"enum": ["strong", "fair", "weak", "poor", "unknown"]},
    "strings": {"type": "array", "items": {"type": "string"}},
    "phrase_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phrase", "quote"],
        "properties": {"phrase": {"type": "string"}, "quote": {"type": "string"}}
      }
    }
  }
}
